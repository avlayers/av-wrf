# Read exclusively by src/av_wrf/cli/env.py (1:1 with RuntimeEnv fields)
AV_WRF_STORE_URI=
AV_WRF_STAGE_STORE_URI=
# R2: https://<accountid>.r2.cloudflarestorage.com
# Leave this empty to use AWS. R2 tokens leave AWS_SESSION_TOKEN empty.
AV_WRF_S3_ENDPOINT=
# R2 accepts auto. An empty value and us-east-1 alias to that region.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AV_WRF_MPI_RANKS=4
# AV_WRF_MPI_LAUNCHER=mpirun -np
AV_WRF_WEBHOOK_URL=
AV_WRF_WEBHOOK_TOKEN=
# Token that can create a repository_dispatch on the consumer repo.
# The workflow GITHUB_TOKEN cannot reach another repository.
AV_WRF_DISPATCH_TOKEN=
AV_WRF_BUILD_MANIFEST=/opt/av-wrf/build-manifest.json
AV_WRF_OCI_DIGEST=
AV_WRF_SOLVER_PREFIX=/opt/av-wrf
AV_WRF_NATIVE_TIMEOUT_S=
